# Провайдер текста: proxyapi (по умолчанию) | gigachat | yandexgpt. Файл .env в Git не попадает.
LLM_PROVIDER=proxyapi

# --- ProxyAPI (https://proxyapi.ru, раздел «API-ключи») ---
# Запросы уходят к зарубежным моделям (OpenAI и др.) через российского посредника.
OPENAI_API_KEY=
# Единый OpenAI-совместимый эндпоинт ProxyAPI; модель указывается полностью: вендор/модель.
OPENAI_BASE_URL=https://api.proxyapi.ru/v1
OPENAI_MODEL=openai/gpt-5-mini
# Прямой OpenAI: OPENAI_BASE_URL=https://api.openai.com/v1 и OPENAI_MODEL=gpt-5-mini

# --- GigaChat (Сбер, https://developers.sber.ru/studio) ---
# «Ключ авторизации» из личного кабинета (Base64 от client_id:client_secret).
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлица и ИП.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# По умолчанию используется certs/russian_trusted_root_ca.pem (корневой сертификат Минцифры).
# GIGACHAT_CA_BUNDLE=

# --- YandexGPT (Yandex AI Studio) ---
# API-ключ сервисного аккаунта с ролью ai.languageModels.user и идентификатор каталога.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Модель внутри каталога: yandexgpt/latest, yandexgpt-lite/latest или полный gpt://...
YANDEX_MODEL=yandexgpt/latest
